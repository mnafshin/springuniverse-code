<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>info.mnafshin.springuniverse</groupId>
        <artifactId>springuniverse-code</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>module-05-shop</artifactId>
    <name>Module 5: the shop app (T5.1 how auto-configuration decides)</name>
    <description>T5.1 v6: one shop app, one topic (the DataSource). Every run prints two things: how many auto-configuration
        candidates Spring Boot read, and how many data sources exist. Maven profiles add the JDBC starter (jdbc), H2 (h2),
        or our own small DataSource auto-configuration from module-05-shop-datasource (mydb).</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <!-- ./mvnw -pl module-05-shop -Pjdbc ...      adds spring-boot-starter-jdbc: the app fails, "Failed to configure a DataSource"
         ./mvnw -pl module-05-shop -Pjdbc,h2 ...   adds the H2 database too: Spring Boot builds an in-memory data source
         ./mvnw -pl module-05-shop -Pmydb ...      adds our own MyDataSourceAutoConfiguration (module-05-shop-datasource) and H2 -->
    <profiles>
        <profile>
            <id>jdbc</id>
            <dependencies>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-jdbc</artifactId>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>h2</id>
            <dependencies>
                <dependency>
                    <groupId>com.h2database</groupId>
                    <artifactId>h2</artifactId>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <!-- src/mydb/java adds the shop's own DataSource bean, active only with the Spring profile "owndb" -->
        <profile>
            <id>mydb</id>
            <dependencies>
                <dependency>
                    <groupId>info.mnafshin.springuniverse</groupId>
                    <artifactId>module-05-shop-datasource</artifactId>
                    <version>${project.version}</version>
                </dependency>
                <dependency>
                    <groupId>com.h2database</groupId>
                    <artifactId>h2</artifactId>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>add-mydb-source</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/mydb/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>add-mydb-test-source</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/mydb-test/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- with our data source on the classpath, the default test (no data source) does not apply -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <test>ShopMyDataSourceTest</test>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
