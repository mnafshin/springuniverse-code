<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>info.mnafshin.springuniverse</groupId>
        <artifactId>springuniverse-code</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>module-05-shop-datasource</artifactId>
    <name>Module 5: our own small DataSource auto-configuration</name>
    <description>T5.1 v5 "inside one auto-configuration": MyDataSourceAutoConfiguration, the same shape as Spring Boot's own
        DataSourceAutoConfiguration, just small (@ConditionalOnClass on the class, @ConditionalOnMissingBean on the bean).
        The shop app (module-05-autoconfiguration) adds it with -Pmydb.</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- optional: the class condition decides whether H2 is really there -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
