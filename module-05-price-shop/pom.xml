<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>info.mnafshin.springuniverse</groupId>
        <artifactId>springuniverse-code</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>module-05-price-shop</artifactId>
    <name>Module 5: the shop web app that uses the price library (T5.3)</name>
    <description>T5.3 v2: one shop web app. It adds module-05-prices as a dependency and expects a ready PriceFormatter bean.</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>info.mnafshin.springuniverse</groupId>
            <artifactId>module-05-prices</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
