<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>info.mnafshin.springuniverse</groupId>
        <artifactId>springuniverse-code</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>module-05-autoconfiguration</artifactId>
    <name>Module 5: Auto-configuration under the hood</name>
    <description>T5.1: how auto-configuration decides. T5.2: customizing it (package customizing; the starter is in module-05-greeting-starter). Conditions, the conditions evaluation report (--debug), overriding a default with your own bean, a small auto-configuration of our own, and Boot 4's modular auto-configuration</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- several example apps have a main method; the jar starts the signup app -->
                    <mainClass>info.mnafshin.springuniverse.autoconfig.AutoConfigApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <!-- T5.1 Example 2 (decides.onclass.DatabaseApp): add a module and a driver to see the decisions change.
         ./mvnw -pl module-05-autoconfiguration -Pjdbc ...      adds spring-boot-starter-jdbc
         ./mvnw -pl module-05-autoconfiguration -Pjdbc,h2 ...   adds the H2 database too -->
    <profiles>
        <profile>
            <id>jdbc</id>
            <dependencies>
                <dependency>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-jdbc</artifactId>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>h2</id>
            <dependencies>
                <dependency>
                    <groupId>com.h2database</groupId>
                    <artifactId>h2</artifactId>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <!-- T5.1 v5: our own small DataSource auto-configuration (module-05-shop-datasource), plus H2 for it.
             src/mydb/java adds the shop's own DataSource bean, active only with the Spring profile "owndb". -->
        <profile>
            <id>mydb</id>
            <dependencies>
                <dependency>
                    <groupId>info.mnafshin.springuniverse</groupId>
                    <artifactId>module-05-shop-datasource</artifactId>
                    <version>${project.version}</version>
                </dependency>
                <dependency>
                    <groupId>com.h2database</groupId>
                    <artifactId>h2</artifactId>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>add-mydb-source</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/mydb/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>add-mydb-test-source</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/mydb-test/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- with our data source on the classpath, the default tests (which expect no data source) do not
                         apply: this profile runs only its own test -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <test>ShopMyDataSourceTest</test>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
