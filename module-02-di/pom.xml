<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>info.mnafshin.springuniverse</groupId>
        <artifactId>springuniverse-code</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>module-02-di</artifactId>
    <name>Module 2: IoC and dependency injection</name>
    <description>T2.1: the same signup service wired by hand in plain Java, then by the Spring container</description>

    <dependencies>
        <!-- Only the Spring version (package ...di.spring) uses this; package ...di.plain has no Spring imports. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>info.mnafshin.springuniverse.di.spring.DiApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
